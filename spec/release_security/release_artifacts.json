      "ZIGOS_RELEASE_TRUST_ROOT_SHA256",
      "ZIGOS_RELEASE_TRUST_POLICY",
      "ZIGOS_RELEASE_VERIFIER",
      "ZIGOS_RELEASE_VERIFIER_SHA256",
      "ZIGOS_RELEASE_DSSE_SIGN_COMMAND",
      "ZIGOS_RELEASE_SIGNING_KEY_ID",
      "ZIGOS_RELEASE_HARDWARE_BACKED"
    ],
    "finalizer_additional_environment": [
      "ZIGOS_RELEASE_TRUST_STATE",
      "ZIGOS_RELEASE_SEQUENCE",
      "ZIGOS_RELEASE_EXPIRES_AT"
    ],
    "post_quantum_policy": {
      "mode": "shadow",
      "fips_validated_required": true,
      "fips_140_validation_required": true,
      "production_signature_algorithm": "ml-dsa-65",
      "key_establishment_algorithm": "ml-kem-768",
      "backup_signature_algorithm": "slh-dsa-sha2-128s",
      "classical_baseline": "Ed25519 remains the classical DSSE baseline during migration; required mode fails closed unless a separately validated FIPS 204 ML-DSA provider is available.",
      "standards": [
        {
          "fips": "FIPS 203",
          "algorithm": "ML-KEM",
          "scope": "key establishment and transport encryption only"
        },
        {
          "fips": "FIPS 204",
          "algorithm": "ML-DSA",
          "scope": "release, update, package, and attestation signatures when production PQC is required"
        },
        {
          "fips": "FIPS 205",
          "algorithm": "SLH-DSA",
          "scope": "hash-based signature diversity for long-lived offline roots and emergency recovery policy"
        }
      ],
      "rollout": [
        "shadow: authenticate and measure policy while Ed25519 DSSE remains required",
        "canary: run an external ML-DSA provider trial while Ed25519 remains the verifier acceptance signature and required mode stays fail-closed",
        "required: require zigos-verify-release to verify ML-DSA signatures from FIPS-validated providers"
      ]
    },
    "verifier_protocols": [
      "Obtain root metadata out-of-band and compare its independently distributed SHA-256 pin before use.",
      "Require the pinned root minimumPolicyVersion and root-signed policy minimumReleaseSequence checkpoints before accepting first-use release state.",
      "Verify the root threshold DSSE signature on release-trust-policy.dsse.json before parsing its payload.",
      "Verify the release-key DSSE signature on release-manifest.dsse.json before parsing its payload; it is the sole digest authority.",
      "Require the exact 33-target production catalog and exact ten-file evidence catalog, rejecting missing, duplicate, extra, or unsafe names.",
      "Keep persistent rollback state external to the bundle and artifact root; reject rollback and equivocation before atomically advancing state.",
      "Serialize state validation and advancement while retaining one validated state-directory handle for descriptor-relative lock, read, temporary-file, rename, and directory-sync operations.",
      "Reject rollback-state directories, files, and lock files with unsafe mode bits, the wrong effective-user owner, or any macOS extended ACL, checking the exact opened descriptors.",
      "Record authenticated decoded policy and manifest payload digests for equivocation identity rather than malleable outer DSSE envelope bytes.",
      "Keep the candidate bundle and exact 33 authenticated target files private and quiescent, preferably read-only or immutable, throughout hashing and verification; the separate hardware-proof output may remain writable, and concurrent same-user replacement of authenticated inputs is outside the verifier threat model.",
      "Use manual root rotation through an explicit out-of-band re-pin and state migration; automatic root rotation is unsupported.",
      "Verify per-target DSSE SLSA provenance only after the authenticated release manifest authorizes its evidence digest.",
      "Require signed SLSA Jujutsu sourceControl=jj, changeId, commit id, repository, Zig version, ReleaseFast optimize mode, and zero dirty workspace evidence.",
      "Apply revocations from the root-threshold-signed policy and reject a revoked release signer.",
      "Reject required ML-DSA mode unless a validated FIPS 204 provider signature verifies; post_quantum_policy also records FIPS 203 ML-KEM and FIPS 205 SLH-DSA migration requirements.",
      "Compare artifact-measurements exact coverage and reproducible-build source and digest evidence with the authenticated manifest.",
      "Copy an independently obtained zigos-verify-release verifier into a protected staging directory, match that exact executable to its external SHA-256 pin, and run it over the full bundle before trusting any target, artifact-measurements record, SBOM, or SLSA payload."
    ]
  },
