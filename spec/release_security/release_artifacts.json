    "trust_policy_payload_type": "application/vnd.zigos.release-trust-policy.v1+json",
    "signed_manifest_is_sole_digest_authority": true,
    "signature_verified_before_payload_parsing": true,
    "candidate_verified_before_publication": true,
    "publication_withdrawn_on_final_verification_failure": true,
    "finalization_lock_required": true,
    "quiescent_authenticated_inputs_required": true,
    "exact_target_set_required": true,
    "exact_evidence_set_required": true
  },
  "release_trust": {
    "root_metadata_source": "out-of-band",
    "root_digest_pin_required": true,
    "root_threshold_signatures_required": true,
    "root_minimum_policy_checkpoint_required": true,
    "policy_minimum_release_checkpoint_required": true,
    "release_policy_root_threshold_signed": true,
    "release_manifest_release_key_signed": true,
    "revocations_in_signed_policy": true,
    "persistent_rollback_state_required": true,
    "rollback_state_external_to_bundle": true,
    "rollback_state_external_to_artifacts": true,
    "rollback_state_transaction_lock_required": true,
    "rollback_state_authenticated_payload_digests": true,
    "rollback_state_darwin_acl_free_storage_required": true,
    "rollback_and_equivocation_rejected": true,
    "rollback_claim_scope": "independently pinned minimum checkpoints plus locally observed persistent state",
    "independently_pinned_verifier_required": true,
    "automatic_root_rotation": false,
    "root_rotation_policy": "manual out-of-band re-pin and state migration only"
  },
  "release_signing": {
    "provider_boundary": "TPM, secure enclave, offline HSM, or cloud KMS signing provider; release code receives key handles only, never seed material",
    "hardware_backed_required": true,
    "revocation_required": true,
    "customer_verifiable_required": true,
    "external_signer_required": true,
    "dsse_signature_output_base64_required": true,
    "generator_required_environment": [
