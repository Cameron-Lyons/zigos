  "release_signing": {
    "provider_boundary": "TPM, secure enclave, offline HSM, or cloud KMS signing provider; release code receives key handles only, never seed material",
    "hardware_backed_required": true,
    "rotation_required": true,
    "revocation_required": true,
    "customer_verifiable_required": true,
    "static_dsse_signatures_local_preview_only": true,
    "dsse_signature_output_base64_required": true,
    "release_verifier_metadata_schema": "zigos.release-verifier-metadata",
    "attestation_verifier_metadata_schema": "zigos.attestation-verifier-metadata",
    "verifier_metadata_digest_required": true,
    "post_quantum_policy": {
      "mode": "shadow",
      "fips_validated_required": true,
      "fips_140_validation_required": true,
      "production_signature_algorithm": "ml-dsa-65",
      "key_establishment_algorithm": "ml-kem-768",
      "backup_signature_algorithm": "slh-dsa-sha2-128s",
      "classical_baseline": "Ed25519 remains the classical DSSE baseline during migration; public required mode needs a separately verified FIPS 204 ML-DSA signature from a validated provider.",
      "standards": [
        {
          "fips": "FIPS 203",
          "algorithm": "ML-KEM",
          "scope": "key establishment and transport encryption only"
        },
        {
          "fips": "FIPS 204",
          "algorithm": "ML-DSA",
          "scope": "release, update, package, and attestation signatures when production PQC is required"
        },
        {
          "fips": "FIPS 205",
          "algorithm": "SLH-DSA",
          "scope": "hash-based signature diversity for long-lived offline roots and emergency recovery policy"
        }
      ],
      "rollout": [
        "shadow: emit policy and verifier measurements while Ed25519 DSSE remains required",
        "canary: dual-sign selected release channels with Ed25519 and validated ML-DSA, failing closed on malformed PQC signatures",
        "required: require zigos-verify-release to verify ML-DSA signatures from FIPS-validated providers before accepting public releases"
      ]
    },
    "verifier_protocols": [
      "verify artifact-digests.sha256 against downloaded artifacts",
      "verify DSSE signatures over application/vnd.in-toto+json payloads before parsing provenance",
      "verify release-keyring.json post_quantum_policy covers FIPS 203 ML-KEM, FIPS 204 ML-DSA, FIPS 205 SLH-DSA, FIPS-validated provider requirements, the classical Ed25519 baseline, and measured rollout",
      "verify SLSA provenance predicate type, exactly one subject per DSSE envelope, and subject digests",
      "verify zigos-verify-release fails closed unless signed SLSA buildDefinition.buildType is https://github.com/Cameron-Lyons/zigos/release-security-gate, runDetails.builder.id is zigos-local-release-security-gate, externalParameters record sourceControl=jj, Jujutsu changeId, commit id, repository, and Zig version, and runDetails.metadata records a zero dirtyWorkspaceFileCount",
      "require signed SLSA optimizeMode and reproducible-build optimize_mode to both equal ReleaseFast",
      "verify release-keyring.json key ids, custody, generation, and not-before/not-after bounds against signed SLSA runDetails.metadata.startedOn",
      "verify release-keyring.json verifier metadata schema and digest match the provider key id, generation, custody, public key, verifier protocol, and FIPS posture before trusting a release key",
      "reject revoked key ids or generations listed in revoked-release-keys.json",
      "reject required ML-DSA rollout unless zigos-verify-release verifies a production ML-DSA signature from a validated provider",
      "compare artifact-measurements.json size and digest measurements against downloaded artifacts with exact one-entry-per-artifact coverage and duplicate rejection",
      "compare reproducible-build.json and reproducible-artifact-digests.sha256 against the complete release digest manifest, including fail-closed repo_vcs=jj, repository, Jujutsu change ID, commit id, Zig version, zero dirty workspace evidence, and equality with the signed SLSA source identity",
      "run zigos-verify-release over the downloaded release bundle before trusting artifact measurements or SLSA provenance"
    ],
    "trusted_key_material": [
      "spec/release_security/release_keyring.json",
      "spec/release_security/revoked_release_keys.json"
    ]
  },
